# Copia este archivo como .env.local y completa los valores. Nunca subas .env.local.

# Cadena de conexión de Neon Postgres. En Vercel la inyecta la integración de Neon.
DATABASE_URL="postgresql://usuario:clave@ep-ejemplo.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Contraseña para entrar en /entrar y escribir poemas.
OWNER_PASSWORD="cambia-esta-contraseña"

# Secreto para firmar la cookie de sesión (mínimo 32 caracteres).
# Genera uno con: openssl rand -base64 32
AUTH_SECRET=""
