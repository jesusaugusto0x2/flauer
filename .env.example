# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Neon Postgres connection string. On Vercel the Neon integration injects it.
DATABASE_URL="postgresql://user:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Password for /login, needed to write poems.
OWNER_PASSWORD="change-this-password"

# Password that opens poems, notes and videos to read (songs are always open).
# Without it, nothing opens: only the owner and share links get in.
READER_PASSWORD="change-this-too"

# Secret used to sign the session cookie (at least 32 characters).
# Generate one with: openssl rand -base64 32
AUTH_SECRET=""

# Optional: an email to the owner whenever a share link opens its item.
# On Vercel, the Resend integration sets RESEND_API_KEY and RESEND_EMAIL_DOMAIN.
RESEND_API_KEY=""
RESEND_EMAIL_DOMAIN=""
SHARE_ALERT_EMAIL=""
